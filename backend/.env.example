# Heart Sync Healthcare Platform — Environment Configuration Template
# Copy this file to .env for local development. NEVER commit real .env files to Git.

# Application Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Both MONGODB_URI and MONGO_URI are supported)
# In production, provide your MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/heart_sync?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/Heart_sync

# JWT Secret — In production, provide a strong 64+ char cryptographically random key.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_hex_key_in_production

# Allowed Frontend Origins for CORS (single URL or comma-separated list)
FRONTEND_URL=http://localhost:5173
